#!/usr/bin/env python3
import argparse
import os
import sys

import pandas as pd
import dns.resolver
from dns.exception import DNSException


def get_ip(domain):
    """Пытается получить IP (A-запись) для домена.
    Возвращает IP-строку или None, если домен не зарезолвился."""
    domain = domain.strip()
    if not domain:
        return None

    try:
        answers = dns.resolver.resolve(domain, 'A')
        # Если адресов несколько — склеиваем через запятую
        return ", ".join([rdata.address for rdata in answers])
    except (dns.resolver.NXDOMAIN, dns.resolver.NoAnswer,
            dns.resolver.Timeout, DNSException):
        return None
    except Exception:
        return None


def parse_args():
    parser = argparse.ArgumentParser(
        description="Резолв списка доменов в IP. Успешные — в Excel, неуспешные — в txt.",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter
    )
    parser.add_argument(
        "-i", "--input",
        default="domains.txt",
        help="Файл со списком доменов (по одному в строке)"
    )
    parser.add_argument(
        "-o", "--output",
        default="result.xlsx",
        help="Имя выходного Excel-файла (только успешные резолвы)"
    )
    parser.add_argument(
        "-f", "--failed",
        default="failed.txt",
        help="Файл для доменов, которые не удалось зарезолвить"
    )
    return parser.parse_args()


def main():
    args = parse_args()

    # 1. Читаем список доменов
    try:
        with open(args.input, 'r') as f:
            domains = [line.strip() for line in f if line.strip()]
    except FileNotFoundError:
        print(f"Ошибка: Файл '{args.input}' не найден.", file=sys.stderr)
        sys.exit(1)

    if not domains:
        print(f"Файл '{args.input}' пуст.", file=sys.stderr)
        sys.exit(1)

    # 2. Резолвим
    print(f"Начинаю резолв {len(domains)} доменов из '{args.input}'...")
    results = []          # только успешные
    failed_domains = []   # только неуспешные

    for d in domains:
        ip = get_ip(d)
        if ip is None:
            failed_domains.append(d)
            print(f"{d} -> НЕ РЕЗОЛВИТСЯ")
        else:
            results.append({"Domain": d, "IP": ip})
            print(f"{d} -> {ip}")

    # 3. Сохраняем Excel (только успешные)
    if results:
        df = pd.DataFrame(results)
        df.to_excel(args.output, index=False)
        print(f"\nУспешно зарезолвлено: {len(results)} → '{args.output}'")
    else:
        print("\nНет успешно зарезолвленных доменов — Excel-файл не создан.")
        # Если старый файл остался от прошлого запуска — удаляем
        if os.path.exists(args.output):
            os.remove(args.output)
            print(f"(Удалён старый '{args.output}')")

    # 4. Сохраняем неразрезолвленные
    if failed_domains:
        with open(args.failed, 'w') as f:
            for d in failed_domains:
                f.write(d + "\n")
        print(f"Не удалось зарезолвить: {len(failed_domains)} → '{args.failed}'")
    else:
        print("Все домены успешно зарезолвлены.")
        if os.path.exists(args.failed):
            os.remove(args.failed)
            print(f"(Удалён старый '{args.failed}')")


if __name__ == "__main__":
    main()
